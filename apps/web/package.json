{
  "name": "meal-planner-web",
  "version": "0.1.0",
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "./scripts/run-ng.sh",
    "prestart": "node ./scripts/generate-runtime-env.mjs",
    "start": "./scripts/run-ng.sh serve --port 4300",
    "prebuild": "node ./scripts/generate-runtime-env.mjs && npm run audit:design-system",
    "build": "CI=1 ./scripts/run-ng.sh build --no-progress",
    "audit:design-system": "node ./scripts/check-design-system.mjs",
    "import:mealime": "node ./scripts/import-mealime.mjs",
    "test:importer": "node --test ./scripts/lib/*.test.mjs",
    "prewatch": "node ./scripts/generate-runtime-env.mjs",
    "watch": "./scripts/run-ng.sh build --watch --configuration development --no-progress",
    "test": "./scripts/run-ng.sh test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@lucide/angular": "^1.47.0",
    "@supabase/supabase-js": "^2.78.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.158.0"
  }
}
